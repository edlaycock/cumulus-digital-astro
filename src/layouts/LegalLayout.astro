---
// Shared wrapper for Markdown-authored legal/compliance pages, so documents
// migrated verbatim from the old site keep their text untouched while
// picking up the house hero and prose styling.
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <PageHero eyebrow={frontmatter.eyebrow}>
    <Fragment set:html={frontmatter.heroTitle} />
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="prose">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>
