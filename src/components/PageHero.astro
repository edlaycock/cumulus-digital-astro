---
import { GlassFold } from './ui/glass-fold';

interface Props {
  eyebrow: string;
  lede?: string;
  /** Animated glass-fold WebGL background on a deep navy ground; the copy
      goes white. Used on the About and Contact heroes. */
  glass?: boolean;
  /** smaller display size and a wider measure — for long editorial titles
      (blog posts) that would sprawl at the full display size */
  compact?: boolean;
}
const { eyebrow, lede, glass = false, compact = false } = Astro.props;
---

<section
  class={`page-hero${glass ? ' page-hero--glass' : ''}${compact ? ' page-hero--compact' : ''}`}
>
  {glass && (
    <div class="page-hero-bg" aria-hidden="true">
      <GlassFold client:load />
    </div>
  )}
  <div class="container">
    <p class="eyebrow reveal d1">
      <span class="eyebrow-dot"></span>
      {eyebrow}
    </p>
    <h1 class="page-hero-title reveal d2"><slot /></h1>
    {lede && <p class="lede reveal d3">{lede}</p>}
    {Astro.slots.has('actions') && (
      <div class="page-hero-actions reveal d4"><slot name="actions" /></div>
    )}
  </div>
</section>
