---
import { getCollection } from 'astro:content';
import { EMAIL, FORM_ENDPOINT } from '../consts';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<form
  class="contact-form"
  id="contact-form"
  method="POST"
  action={FORM_ENDPOINT || undefined}
  data-endpoint={FORM_ENDPOINT}
  data-email={EMAIL}
>
  <div class="form-row">
    <div class="form-field">
      <label for="cf-name">Name</label>
      <input id="cf-name" name="name" type="text" required autocomplete="name" />
    </div>
    <div class="form-field">
      <label for="cf-email">Email</label>
      <input id="cf-email" name="email" type="email" required autocomplete="email" />
    </div>
  </div>

  <div class="form-row">
    <div class="form-field">
      <label for="cf-phone">Phone <span class="form-optional">(optional)</span></label>
      <input id="cf-phone" name="phone" type="tel" autocomplete="tel" />
    </div>
    <div class="form-field">
      <label for="cf-service">What do you need?</label>
      <select id="cf-service" name="service">
        <option value="">Not sure yet</option>
        {services.map((s) => <option value={s.data.title}>{s.data.title}</option>)}
        <option value="Travel industry project">Travel industry project</option>
      </select>
    </div>
  </div>

  <div class="form-field">
    <label for="cf-message">Tell us about your project</label>
    <textarea id="cf-message" name="message" rows="6" required></textarea>
  </div>

  <!-- honeypot -->
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="form-honeypot" aria-hidden="true" />

  <div class="form-actions">
    <button class="btn btn--primary btn--lg" type="submit" data-submit>
      <span class="form-btn-label">Send message →</span>
      <span class="form-spinner" aria-hidden="true"></span>
    </button>
    <p class="form-alt">
      Prefer email? <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
    </p>
  </div>

  <p class="form-status" role="status" aria-live="polite"></p>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  // ---- per-field validation ------------------------------------------------
  const MESSAGES: Record<string, string> = {
    name: 'Please tell us your name.',
    email: 'Please enter an email address we can reply to.',
    message: 'Please tell us a little about your project.',
  };

  const fieldOf = (el: HTMLElement) => el.closest('.form-field');

  const setError = (el: HTMLInputElement | HTMLTextAreaElement, message: string | null) => {
    const field = fieldOf(el);
    if (!field) return;
    let msg = field.querySelector('.field-error') as HTMLElement | null;
    if (message) {
      if (!msg) {
        msg = document.createElement('p');
        msg.className = 'field-error';
        msg.id = `${el.id}-error`;
        field.appendChild(msg);
      }
      msg.textContent = message;
      field.classList.add('form-field--invalid');
      el.setAttribute('aria-invalid', 'true');
      el.setAttribute('aria-describedby', msg.id);
    } else {
      msg?.remove();
      field.classList.remove('form-field--invalid');
      el.removeAttribute('aria-invalid');
      el.removeAttribute('aria-describedby');
    }
  };

  const validate = (el: HTMLInputElement | HTMLTextAreaElement) => {
    const value = el.value.trim();
    if (!el.required && !value) return true;
    if (!value) { setError(el, MESSAGES[el.name] ?? 'This field is required.'); return false; }
    if (el.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
      setError(el, "That email doesn't look quite right — please check it.");
      return false;
    }
    setError(el, null);
    return true;
  };

  const fields = () =>
    [...(form?.querySelectorAll('input[required], textarea[required], input[type=email]') ?? [])] as (
      | HTMLInputElement
      | HTMLTextAreaElement
    )[];

  // validate on blur, and clear the error as soon as they start fixing it
  fields().forEach((el) => {
    el.addEventListener('blur', () => validate(el));
    el.addEventListener('input', () => {
      if (el.getAttribute('aria-invalid') === 'true') validate(el);
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const endpoint = form.dataset.endpoint;
    const status = form.querySelector('.form-status') as HTMLElement;
    const button = form.querySelector('[data-submit]') as HTMLButtonElement | null;
    const data = new FormData(form);
    if ((data.get('_gotcha') as string)?.length) return;

    // stop here if anything is invalid, and move focus to the first problem
    const bad = fields().filter((el) => !validate(el));
    if (bad.length) {
      status.textContent = 'Please check the highlighted fields.';
      status.classList.add('form-status--error');
      bad[0].focus();
      return;
    }
    status.classList.remove('form-status--error');

    if (!endpoint) {
      // No form service configured yet — fall back to the user's email client
      const subject = encodeURIComponent(`Project enquiry — ${data.get('service') || 'general'}`);
      const body = encodeURIComponent(
        `Name: ${data.get('name')}\nEmail: ${data.get('email')}\nPhone: ${data.get('phone') || '-'}\n\n${data.get('message')}`
      );
      window.location.href = `mailto:${form.dataset.email}?subject=${subject}&body=${body}`;
      return;
    }

    // ---- loading state ----
    form.classList.add('is-sending');
    if (button) button.disabled = true;
    status.textContent = 'Sending…';

    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      window.location.href = '/thank-you/';
    } catch {
      status.textContent = `Something went wrong sending the form — please email us at ${form.dataset.email}.`;
      status.classList.add('form-status--error');
    } finally {
      form.classList.remove('is-sending');
      if (button) button.disabled = false;
    }
  });
</script>
