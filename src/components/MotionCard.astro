---
// A still that becomes a short looping clip when scrolled into view.
// The poster renders straight away at a fixed aspect ratio (no layout
// shift); the video is only fetched near the viewport, and never under
// reduced motion or Save-Data. Behaviour lives in scripts/motion-cards.ts.
interface Props {
  src: string;
  srcWebm?: string;
  poster: string;
  /** What the clip shows. The card is announced as one image. */
  alt: string;
  /** CSS aspect-ratio, e.g. "4 / 5", "16 / 10". */
  aspect?: string;
  /** Above the fold: poster loads eagerly, video gets preload="metadata". */
  priority?: boolean;
  /** Wrap in the double glass bezel. */
  frame?: boolean;
  class?: string;
}
const { src, srcWebm, poster, alt, aspect = '16 / 10', priority = false, frame = true, class: cls = '' } = Astro.props;
---

<div class={`mc${frame ? ' mc--framed' : ''} ${cls}`} data-motion-card>
  <div class="mc-glass">
    <div class="mc-media" style={`aspect-ratio:${aspect}`} role="img" aria-label={alt}>
      <img
        class="mc-poster"
        src={poster}
        alt=""
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
      <video
        class="mc-video"
        muted
        loop
        playsinline
        disablepictureinpicture
        preload={priority ? 'metadata' : 'none'}
        aria-hidden="true"
        tabindex="-1"
        data-src={src}
        data-src-webm={srcWebm}
      ></video>
    </div>
  </div>
</div>

<script>
  import '../scripts/motion-cards';
</script>
