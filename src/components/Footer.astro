---
import LogoSting from './LogoSting.astro';
import {
  SITE_TAGLINE,
  EMAIL,
  PHONE_DISPLAY,
  PHONE_TEL,
  COMPANY_LEGAL_NAME,
  COMPANY_NUMBER,
  FACEBOOK_URL,
  LINKEDIN_URL,
} from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a class="brand footer-sting" href="/" aria-label="Cumulus Digital home">
        <LogoSting dark />
      </a>
      <p class="footer-tagline">{SITE_TAGLINE}</p>
      <div class="footer-social">
        <a href={FACEBOOK_URL} rel="noopener" target="_blank" aria-label="Cumulus Digital on Facebook">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07" />
          </svg>
        </a>
        <a href={LINKEDIN_URL} rel="noopener" target="_blank" aria-label="Cumulus Digital on LinkedIn">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.8 0 0 .78 0 1.74v20.52C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.74V1.74C24 .78 23.2 0 22.22 0Z" />
          </svg>
        </a>
      </div>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <div class="footer-col">
        <h4>Services</h4>
        <a href="/services/#branding">Branding</a>
        <a href="/services/web-design/">Web Design</a>
        <a href="/services/web-development/">Web Development</a>
        <a href="/services/seo/">SEO</a>
        <a href="/services/ai-seo/">AI SEO &amp; AEO</a>
        <a href="/services/ai-automation/">AI for Business</a>
        <a href="/services/google-ads/">Google Ads</a>
        <a href="/services/#strategy">Strategy &amp; Consulting</a>
      </div>
      <div class="footer-col">
        <h4>Sectors</h4>
        <a href="/services/travel-industry/">Travel Industry</a>
        <a href="/services/trades/">Trades &amp; Construction</a>
      </div>
      <div class="footer-col">
        <h4>Company</h4>
        <a href="/about/">About Us</a>
        <a href="/work/">Our Work</a>
        <a href="/blog/">Blog</a>
        <a href="/contact/">Contact</a>
      </div>
      <div class="footer-col">
        <h4>Contact</h4>
        <a href={`tel:${PHONE_TEL}`}>{PHONE_DISPLAY}</a>
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <p class="footer-address">Proudly based in Surrey</p>
      </div>
    </nav>
  </div>

  <div class="footer-base">
    <div class="container footer-base-inner">
      <p>
        &copy; {year} {COMPANY_LEGAL_NAME}. Registered in England &amp; Wales, company no. {COMPANY_NUMBER}.
      </p>
      <div class="footer-legal">
        <a href="/privacy/">Privacy Policy</a>
        <a href="/terms/">Terms of Use</a>
        <a href="/terms-conditions/">Terms &amp; Conditions</a>
      </div>
    </div>
  </div>
</footer>
