---
// Phone-only action bar. Appears once the hero has scrolled away, so it never
// competes with the hero's own call to action.
import { PHONE_DISPLAY, PHONE_TEL } from '../consts';
---

<div class="sticky-cta" id="sticky-cta" aria-hidden="true">
  <a class="sticky-cta-call" href={`tel:${PHONE_TEL}`}>
    <svg viewBox="0 0 24 24" fill="none" width="18" height="18" aria-hidden="true">
      <path
        d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3Z"
        stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
    </svg>
    <span class="sr-only">Call </span>{PHONE_DISPLAY}
  </a>
  <a class="btn btn--primary sticky-cta-btn" href="/contact/">Start a project →</a>
</div>

<script>
  (() => {
    const bar = document.getElementById('sticky-cta');
    if (!bar) return;
    // don't nag people already on the contact page
    if (location.pathname.replace(/\/$/, '') === '/contact') return;

    const update = () => {
      const past = window.scrollY > window.innerHeight * 0.6;
      bar.classList.toggle('is-visible', past);
      bar.setAttribute('aria-hidden', String(!past));
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  })();
</script>
