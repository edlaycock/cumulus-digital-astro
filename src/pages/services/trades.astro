---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImpactHero from '../../components/ImpactHero.astro';
import WorkPreview from '../../components/WorkPreview.astro';
import { Image } from 'astro:assets';
import ytqDesktop from '../../assets/products/ytq-dashboard-desktop.png';
import ytqMobile from '../../assets/products/ytq-dashboard-mobile.png';
import ytqLogo from '../../assets/products/ytq-logo.png';
import ytwLogo from '../../assets/products/ytw-logo.png';
import { getCollection } from 'astro:content';
import { PHONE_DISPLAY, PHONE_TEL } from '../../consts';

// Real trade and construction clients — proof, not stock claims.
const TRADE_SLUGS = [
  'surrey-contracting',
  'surrey-hills-surfacing',
  'oakbridge-group',
  'macdonald-fencing-sons',
  'sussex-groundworks',
  'tts-surfacing-ltd',
];
const all = await getCollection('work');
const proof = TRADE_SLUGS.map((s) => all.find((w) => w.id === s)).filter(Boolean);

// The enquiry-to-paid flow the two products cover between them.
const flow = [
  { h: 'Enquiry captured', p: 'Website forms land straight in a live pipeline, with real-time alerts.' },
  { h: 'Customer created', p: 'One click turns an enquiry into a customer record — no re-typing.' },
  { h: 'Quote built and sent', p: 'Itemised, branded, sent as a PDF by email or WhatsApp.' },
  { h: 'Accepted and signed', p: 'Customers sign digitally on any device. Name, signature, timestamp.' },
  { h: 'Job scheduled', p: 'Accepted quotes become jobs on a drag-and-drop calendar.' },
  { h: 'Invoiced and paid', p: 'Invoice raised against the job, with a Stripe payment link.' },
];

const problems = [
  {
    n: '01',
    h: 'The enquiry never gets made',
    p: 'Someone finds you on a phone, standing in the garden they want dug out. If your number is buried three taps deep, they ring the next contractor instead.',
  },
  {
    n: '02',
    h: 'You look smaller than you are',
    p: 'Serious commercial and developer clients check whether you can handle the job. A thin site makes an experienced firm look like a one-van operation.',
  },
  {
    n: '03',
    h: 'Nobody can see the work',
    p: 'Trades sell on finished jobs. If the gallery is six photos from 2019, the site is arguing against you.',
  },
  {
    n: '04',
    h: 'You are invisible locally',
    p: 'Most trade work starts with a local search. Without proper location pages and a maintained Google Business Profile, you are missing the enquiries entirely.',
  },
];

const services = [
  { name: 'Local SEO & Google Business Profile', body: 'Ranking for "groundworks near me" and the towns you actually cover, with a profile that stays current.' },
  { name: 'Service-area pages', body: 'A real page per town and per discipline — the pages that win local searches instead of one catch-all services page.' },
  { name: 'Accreditation & trust signals', body: 'CHAS, SafeContractor, SSIP, Gas Safe, NICEIC, insurance — the things commercial buyers check before they call.' },
  { name: 'Project galleries', body: 'Your finished work, properly photographed and easy for your team to add to without a developer.' },
  { name: 'Quote request flows', body: 'Short, mobile-first forms and tap-to-call, because most trade enquiries start on a phone on site.' },
  { name: 'Google Ads', body: 'Paid search for the jobs you want more of, with the timewasters filtered out by negative keywords.' },
];

const faqs = [
  {
    q: 'We get all our work by word of mouth. Why do we need a website?',
    a: 'Because word of mouth still ends with someone looking you up. A recommendation gets your name mentioned; your website decides whether they call. It also lets you go after the larger commercial and developer work that referrals rarely reach.',
  },
  {
    q: 'Can we update the project gallery ourselves?',
    a: 'Yes. We build the projects area so your team can add a job with photos from a phone, without going back to a developer each time. OakBridge Group came to us specifically for that.',
  },
  {
    q: 'Do you understand construction terminology?',
    a: 'We have built for groundworks, surfacing, demolition, fencing, landscaping, orangeries and steel glazing firms. We know the difference between enabling works and external works, and we will not write copy that makes you sound like a marketing brochure.',
  },
  {
    q: 'How quickly can we be live?',
    a: 'A focused trade website is usually a matter of weeks, not months. Castellum was turned around in two weeks because they had PR going out and needed the site to match.',
  },
];
---

<BaseLayout
  title="Digital Marketing for Trades | Cumulus Digital, Surrey"
  description="Websites, local SEO and Google Ads for groundworks, surfacing, fencing, landscaping and construction firms across Surrey and the South East."
>
  <ImpactHero
    badge="Built for UK tradespeople"
    title="Win the enquiry."
    titleAccent="Get paid faster."
    lede="Websites, local SEO and paid search for trades — plus our own platform to turn those enquiries into quotes, scheduled jobs and paid invoices."
    ticks={['Websites from £499', 'Quote system from £19/month', 'No long-term contracts']}
    ctaText="Talk to us →"
    ctaHref="/contact/"
    secondaryText="See the platform"
    secondaryHref="#products"
    desktop={ytqDesktop}
    mobile={ytqMobile}
    alt="The YourTradeQuotes dashboard, showing enquiries, quotes and job pipeline"
    chips={[
      { text: 'New enquiry', at: 'tr' },
      { text: 'Quote accepted · Signed', at: 'bl' },
    ]}
  />

  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="section-label">What we see</p>
        <h2 class="section-title">Good firms losing work<br />to worse websites.</h2>
        <p class="section-sub">
          The quality of the work on the ground is rarely the problem. It's everything that
          happens before the phone rings.
        </p>
      </div>
      <div class="values-grid">
        {problems.map((x, i) => (
          <div class="value-card" data-reveal style={`--reveal-delay:${i * 0.08}s`}>
            <span class="value-num">{x.n}</span>
            <h3>{x.h}</h3>
            <p>{x.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--grey-50)">
    <div class="container">
      <div class="section-header">
        <p class="section-label">What we do</p>
        <h2 class="section-title">Built for how trade<br />customers actually search.</h2>
      </div>
      <ul class="services-grid" role="list">
        {services.map((s) => (
          <li class="service-card">
            <div class="service-card-body"><h3>{s.name}</h3><p>{s.body}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- our own products -->
  <section class="section ytp" id="products">
    <div class="container">
      <div class="section-header">
        <p class="section-label">Our own platform</p>
        <h2 class="section-title">We didn't just build this<br />for trades. We built it ourselves.</h2>
        <p class="section-sub">
          YourTradeWebsites.com and YourTradeQuotes.com are our own products — both trading
          names of Cumulus Digital. A website that wins the enquiry, and a system that turns it
          into a paid invoice.
        </p>
      </div>

      <div class="ytp-grid">
        <article class="ytp-card" data-reveal>
          <Image class="ytp-logo" src={ytwLogo} alt="YourTradeWebsites.com" widths={[220, 440]} sizes="200px" />
          <p class="ytp-price">Websites from <strong>£499</strong> +VAT · live in 2&ndash;3 weeks</p>
          <p>
            Professional, mobile-first websites built for a specific trade rather than dropped on
            a template. Local SEO built in, lead-capture forms that feed straight into the quote
            system, hosting and SSL included.
          </p>
          <ul role="list">
            <li>Three-, five- and eight-page packages</li>
            <li>Built for local search from the start</li>
            <li>Care plans from £29/month, no long-term contract</li>
          </ul>
          <a class="ytp-link" href="https://yourtradewebsites.com" target="_blank" rel="noopener">
            Visit YourTradeWebsites.com &rarr;
          </a>
        </article>

        <article class="ytp-card" data-reveal style="--reveal-delay:.1s">
          <Image class="ytp-logo" src={ytqLogo} alt="YourTradeQuotes.com" widths={[220, 440]} sizes="200px" />
          <p class="ytp-price">From <strong>£19</strong>/month +VAT · 14-day free trial</p>
          <p>
            The job runs from one place: enquiries land in a live pipeline, quotes are built in
            minutes and signed digitally, accepted quotes become scheduled jobs, and invoices go
            out against the job.
          </p>
          <ul role="list">
            <li>Real-time enquiry alerts and an itemised quote builder</li>
            <li>Digital signatures, Stripe payment links, automatic invoicing</li>
            <li>Drag-and-drop scheduling, job photos and field sign-off</li>
          </ul>
          <a class="ytp-link" href="https://yourtradequotes.com" target="_blank" rel="noopener">
            Visit YourTradeQuotes.com &rarr;
          </a>
        </article>
      </div>

      <!-- the flow between the two -->
      <h3 class="ytp-flow-title">Enquiry to paid, without the WhatsApp chaos</h3>
      <ol class="ytp-flow" role="list">
        {flow.map((f, i) => (
          <li class="ytp-step" data-reveal style={`--reveal-delay:${i * 0.06}s`}>
            <span class="ytp-step-n">{String(i + 1).padStart(2, '0')}</span>
            <strong>{f.h}</strong>
            <span>{f.p}</span>
          </li>
        ))}
      </ol>

      <p class="ytp-note">
        Both products are ours, so if something needs changing for your business we can change
        it &mdash; you are not filing a ticket with a company on the other side of the world.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="section-label">Proof</p>
        <h2 class="section-title">100's of trade &amp; construction<br />projects delivered.</h2>
        <p class="section-sub">A few of the contractors we've built for.</p>
      </div>
      <ul class="work-grid" role="list">
        {proof.map((item) => (
          <li class="work-card">
            <a class="work-card-inner" href={`/work/${item!.id}/`}>
              <WorkPreview client={item!.data.client} url={item!.data.url} image={item!.data.mockup ?? item!.data.image} />
              <div class="work-card-content">
                <span class="work-client">{item!.data.client}</span>
                <h3>{item!.data.title}</h3>
                <span class="work-card-cta">View case study →</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <div class="work-cta">
        <a class="btn btn--outline btn--lg" href="/work/">See all case studies →</a>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--grey-50)">
    <div class="container">
      <div class="section-header">
        <p class="section-label">Common questions</p>
        <h2 class="section-title">Straight answers.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item" data-reveal><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <div class="cta-inner">
        <div class="cta-glow" aria-hidden="true"></div>
        <p class="section-label">Trades &amp; construction</p>
        <h2 class="cta-headline">Let's win you<br />better <em class="glow">work</em>.</h2>
        <p class="cta-sub">Tell us what you do and where you cover. We'll tell you honestly what would move the needle first.</p>
        <div class="cta-actions">
          <a class="btn btn--primary btn--lg" href="/contact/" data-magnetic>Start a project →</a>
          <a class="btn btn--ghost btn--lg" href={`tel:${PHONE_TEL}`}>{PHONE_DISPLAY}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
