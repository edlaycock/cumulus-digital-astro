---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { AnimatedMarqueeHero } from '../components/ui/hero-3';
import WorkPreview from '../components/WorkPreview.astro';

const work = (await getCollection('work'))
  .filter((w) => !w.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

// Marquee: purpose-shot captures of four client sites, taken at exactly the
// frame aspect ratios (16:10 for the MacBook, 9:19.5 for the iPhone) so the
// screen fills its bezel without being cropped or squashed.
const FRAMED = [
  { slug: 'cotswold-house-hunter', client: 'Cotswold House Hunter' },
  { slug: 'jellylearn',            client: 'JellyLearn' },
  { slug: 'surrey-contracting',    client: 'Surrey Contracting' },
  { slug: 'abu-dhabi-holidays',    client: 'Abu Dhabi Holidays' },
];
const frames = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/frames/*.jpg',
  { eager: true }
);
// desktop and mobile alternate, so the strip never runs four laptops together
const framed = await Promise.all(
  FRAMED.flatMap(({ slug, client }) => [
    { slug, client, kind: 'desktop' as const, file: `${slug}-mac.jpg`,   w: 760 },
    { slug, client, kind: 'mobile'  as const, file: `${slug}-phone.jpg`, w: 320 },
  ])
    .filter((e) => frames[`../assets/frames/${e.file}`])
    .map(async (e) => ({
      src: (await getImage({
        src: frames[`../assets/frames/${e.file}`].default,
        width: e.w,
        format: 'webp',
      })).src,
      alt: `${e.client} website built by Cumulus Digital`,
      kind: e.kind,
    }))
);
---

<BaseLayout
  title="Our Work — Web Design & Digital Projects | Cumulus Digital"
  description="Selected projects by Cumulus Digital: bespoke websites, branding and digital marketing for Surrey businesses and travel brands."
>
  <AnimatedMarqueeHero
    client:load
    tagline="Our work · Surrey, UK"
    title="Ideas made real."
    accent="real."
    description="Real websites, brands and marketing for Surrey businesses — from award-winning builders to independent pubs. Here's a selection we're proud of."
    ctaText="Discuss your project →"
    ctaHref="/contact/"
    secondaryText="What we do"
    secondaryHref="/services/"
    images={framed}
  />

  <section class="section work-section">
    <div class="container">
      <ul class="work-grid" role="list">
        {work.map((item) => (
          <li class={`work-card${item.data.wide ? ' work-card--wide' : ''}`}>
            <a class="work-card-inner" href={`/work/${item.id}/`}>
              <WorkPreview client={item.data.client} url={item.data.url} image={item.data.mockup ?? item.data.image} />
              <div class="work-card-content">
                <span class="work-tag">{item.data.services.join(' + ')}</span>
                <span class="work-client">{item.data.client}</span>
                <h3>{item.data.title}</h3>
                <p>{item.data.summary}</p>
                <span class="work-card-cta">View case study →</span>
              </div>
            </a>
          </li>
        ))}
      </ul>

      <div class="work-cta">
        <a class="btn btn--primary btn--lg" href="/contact/">Discuss your project →</a>
      </div>
    </div>
  </section>
</BaseLayout>
