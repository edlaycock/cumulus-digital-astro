---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { PerspectiveTunnelHero } from '../components/ui/perspective-tunnel-hero';
import WorkPreview from '../components/WorkPreview.astro';

const work = (await getCollection('work'))
  .filter((w) => !w.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

// Tunnel hero: portrait captures of real client builds, newest first.
// The 4:5 card crops each capture from the top, so the site's own header
// and hero are what fly past.
const TUNNEL = [
  { file: '../assets/frames/elysian-collection-phone.jpg',    client: 'Elysian Collection' },
  { file: '../assets/frames/cotswold-house-hunter-phone.jpg', client: 'Cotswold House Hunter' },
  { file: '../assets/frames/jellylearn-phone.jpg',            client: 'JellyLearn' },
  { file: '../assets/frames/surrey-contracting-phone.jpg',    client: 'Surrey Contracting' },
  { file: '../assets/work/hersham-village-mobile.jpg',        client: 'Hersham Village' },
  { file: '../assets/work/ras-al-khaimah-holidays-mobile.jpg', client: 'Ras Al Khaimah Holidays' },
  { file: '../assets/work/assetq-mobile.jpg',                 client: 'AssetQ' },
  { file: '../assets/work/fidelity-accountants-mobile.jpg',   client: 'Fidelity Accountants' },
  { file: '../assets/work/surrey-hills-surfacing-mobile.jpg', client: 'Surrey Hills Surfacing' },
];
const shots = import.meta.glob<{ default: ImageMetadata }>(
  ['../assets/frames/*.jpg', '../assets/work/*.jpg'],
  { eager: true }
);
const tunnelCards = await Promise.all(
  TUNNEL.filter((t) => shots[t.file]).map(async (t) => ({
    src: (await getImage({ src: shots[t.file].default, width: 520, format: 'webp' })).src,
    title: t.client,
  }))
);
---

<BaseLayout
  title="Our Work — Web Design & Digital Projects | Cumulus Digital"
  description="Selected projects by Cumulus Digital: bespoke websites, branding and digital marketing for Surrey businesses and travel brands."
>
  <PerspectiveTunnelHero
    client:load
    tagline="Our work · Surrey, UK"
    titleHtml="Ideas made <em>real</em>."
    description="Real websites, brands and marketing for Surrey businesses — from award-winning builders to independent pubs. Here's a selection we're proud of."
    ctaText="Discuss your project →"
    ctaHref="/contact/"
    secondaryText="What we do"
    secondaryHref="/services/"
    cards={tunnelCards}
  />

  <section class="section work-section">
    <div class="container">
      <ul class="work-grid" role="list">
        {work.map((item) => (
          <li class={`work-card${item.data.wide ? ' work-card--wide' : ''}`}>
            <a class="work-card-inner" href={`/work/${item.id}/`}>
              <WorkPreview client={item.data.client} url={item.data.url} image={item.data.mockup ?? item.data.image} />
              <div class="work-card-content">
                <span class="work-tag">{item.data.services.join(' + ')}</span>
                <span class="work-client">{item.data.client}</span>
                <h3>{item.data.title}</h3>
                <p>{item.data.summary}</p>
                <span class="work-card-cta">View case study →</span>
              </div>
            </a>
          </li>
        ))}
      </ul>

      <div class="work-cta">
        <a class="btn btn--primary btn--lg" href="/contact/">Discuss your project →</a>
      </div>
    </div>
  </section>
</BaseLayout>
