---
// Alternative homepage concept: light palette + one client site per screen.
// Not linked from navigation — reachable at /home-2/ for review only.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCards from '../components/ServiceCards';
import WorkPreview from '../components/WorkPreview.astro';

import scDesktop from '../assets/work/surrey-contracting-desktop.jpg';
import scMobile from '../assets/work/surrey-contracting-mobile.jpg';
import jlDesktop from '../assets/work/jellylearn-desktop.jpg';
import jlMobile from '../assets/work/jellylearn-mobile.jpg';
import castDesktop from '../assets/work/castellum-desktop.jpg';
import castMobile from '../assets/work/castellum-mobile.jpg';
import chhDesktop from '../assets/work/cotswold-house-hunter-desktop.jpg';
import chhMobile from '../assets/work/cotswold-house-hunter-mobile.jpg';
import shsDesktop from '../assets/work/surrey-hills-surfacing-desktop.jpg';
import shsMobile from '../assets/work/surrey-hills-surfacing-mobile.jpg';

const services = (await getCollection('services'))
  .filter((s) => s.data.showOnHome)
  .sort((a, b) => a.data.order - b.data.order);

const serviceItems = services.map((s) => ({
  title: s.data.title,
  summary: s.data.summary,
  iconPath: s.data.iconPath,
  href: `/services/#${s.id}`,
  linkText: 'Learn more →',
}));

const work = (await getCollection('work'))
  .filter((w) => !w.data.draft)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

// One client per screen: each slide pairs that site's desktop and mobile view.
const showcase = [
  { client: 'Surrey Contracting',     sector: 'Groundworks & surfacing', desktop: scDesktop,   mobile: scMobile,   href: '/work/surrey-contracting/' },
  { client: 'JellyLearn',             sector: 'Road-safety EdTech',      desktop: jlDesktop,   mobile: jlMobile,   href: '/work/jellylearn/' },
  { client: 'Cotswold House Hunter',  sector: 'Property buying agent',   desktop: chhDesktop,  mobile: chhMobile,  href: '/work/cotswold-house-hunter/' },
  { client: 'Castellum',              sector: 'Luxury construction',     desktop: castDesktop, mobile: castMobile, href: '/work/castellum/' },
  { client: 'Surrey Hills Surfacing', sector: 'Driveways & surfacing',   desktop: shsDesktop,  mobile: shsMobile,  href: '/work/surrey-hills-surfacing/' },
];
---

<BaseLayout
  title="Home concept 2 — Cumulus Digital"
  description="Alternative homepage concept: lighter palette showing one recent client website at a time, on desktop and mobile."
>
  <Fragment slot="head"><meta name="robots" content="noindex" /></Fragment>

  <div class="h2">
    <!-- ===================== HERO ===================== -->
    <section class="h2-hero">
      <div class="h2-wash" aria-hidden="true"></div>

      <div class="container h2-hero-grid">
        <div class="h2-hero-copy">
          <p class="h2-eyebrow"><span class="h2-dot"></span> Digital marketing &amp; web · Surrey, UK</p>
          <h1 class="h2-title">Websites that make ideas <em>happen</em>.</h1>
          <p class="h2-lede">
            Bespoke branding and fast, hand-built websites for ambitious UK
            businesses — backed by 25&nbsp;years in the travel sector.
          </p>
          <div class="h2-cta">
            <a class="btn btn--primary btn--lg" href="/contact/" data-magnetic>Start a project →</a>
            <a class="btn btn--outline btn--lg" href="/work/">See our work</a>
          </div>
          <ul class="h2-stats" role="list">
            <li><strong>28</strong><span>Projects</span></li>
            <li><strong>25+</strong><span>Years in travel</span></li>
            <li><strong>2015</strong><span>Serving Surrey</span></li>
          </ul>
        </div>

        <!-- One client site per screen: desktop and mobile together -->
        <div class="h2-showcase">
          <div class="h2-slides">
            {showcase.map((s, i) => (
              <div class={`h2-slide${i === 0 ? ' is-active' : ''}`} data-slide={i} aria-hidden={i !== 0}>
                <figure class="h2-dev h2-dev--laptop">
                  <div class="h2-screen">
                    <Image src={s.desktop} alt={`${s.client} website on desktop`}
                           widths={[520, 1040]} sizes="480px" loading={i === 0 ? 'eager' : 'lazy'} />
                  </div>
                  <div class="h2-base" aria-hidden="true"></div>
                </figure>
                <figure class="h2-dev h2-dev--phone">
                  <div class="h2-screen">
                    <Image src={s.mobile} alt={`${s.client} website on mobile`}
                           widths={[200, 400]} sizes="130px" loading={i === 0 ? 'eager' : 'lazy'} />
                  </div>
                </figure>
              </div>
            ))}
          </div>

          <script type="application/json" id="h2-showcase-data" set:html={JSON.stringify(showcase.map((s) => ({ client: s.client, sector: s.sector, href: s.href })))} />

          <div class="h2-showcase-meta">
            <p class="h2-showcase-name">
              <a href={showcase[0].href} data-name-link>
                <strong data-name>{showcase[0].client}</strong>
                <span data-sector>{showcase[0].sector}</span>
              </a>
            </p>
            <div class="h2-dots" role="tablist" aria-label="Choose a project">
              {showcase.map((s, i) => (
                <button
                  class={`h2-dot-btn${i === 0 ? ' is-active' : ''}`}
                  type="button"
                  data-go={i}
                  role="tab"
                  aria-selected={i === 0}
                  aria-label={s.client}
                ></button>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== SERVICES ===================== -->
    <section class="section h2-services">
      <div class="container">
        <div class="section-header">
          <p class="section-label">What we do</p>
          <h2 class="section-title">Everything you need<br />to grow online.</h2>
          <p class="section-sub">
            From first impression to lasting impact — strategy, design, code and
            marketing that work together.
          </p>
        </div>
        <ServiceCards items={serviceItems} client:visible />
      </div>
    </section>

    <!-- ===================== WORK ===================== -->
    <section class="section h2-work">
      <div class="container">
        <div class="section-header">
          <p class="section-label">Our work</p>
          <h2 class="section-title">Ideas made real.</h2>
          <p class="section-sub">A few of the 28 projects in our portfolio.</p>
        </div>

        <ul class="work-grid" role="list">
          {work.map((item) => (
            <li class="work-card">
              <a class="work-card-inner" href={`/work/${item.id}/`}>
                <WorkPreview client={item.data.client} url={item.data.url} image={item.data.mockup ?? item.data.image} />
                <div class="work-card-content">
                  <span class="work-tag">{item.data.services.join(' + ')}</span>
                  <span class="work-client">{item.data.client}</span>
                  <h3>{item.data.title}</h3>
                  <p>{item.data.summary}</p>
                  <span class="work-card-cta">View case study →</span>
                </div>
              </a>
            </li>
          ))}
        </ul>

        <div class="work-cta">
          <a class="btn btn--outline btn--lg" href="/work/">See all 28 case studies →</a>
        </div>
      </div>
    </section>

    <!-- ===================== CTA ===================== -->
    <section class="h2-close">
      <div class="container">
        <h2>Let's make your idea happen.</h2>
        <p>Tell us what you're building. We'll tell you honestly how we'd approach it.</p>
        <a class="btn btn--primary btn--lg" href="/contact/" data-magnetic>Start a project →</a>
        <p class="h2-close-loc">Hersham · Walton-on-Thames · Surrey</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* ---------------------------------------------------------------
     Light concept. Scoped to this page — the live homepage is untouched.
     Cyan is too light for text on white, so a deepened cyan carries type
     and the bright accent stays for fills and rules.
  ---------------------------------------------------------------- */
  .h2 {
    --h2-ground: #f6f9fb;
    --h2-panel: #ffffff;
    --h2-accent: #0d7f92;
    --h2-accent-lt: #4fc5d5;
    --h2-text: #141b38;
    --h2-body: #434960;
    --h2-muted: #6b7594;
    --h2-line: #e2e8f0;
    background: var(--h2-ground);
  }

  /* ---- hero: everything inside the first screen ---- */
  .h2-hero {
    position: relative;
    display: flex; align-items: center;
    min-height: 100svh;
    padding: clamp(5.5rem, 11vh, 7.5rem) 0 clamp(1.5rem, 4vh, 3rem);
    overflow: hidden;
    background: var(--h2-ground);
  }
  .h2-wash {
    position: absolute;
    inset: -25% -10% auto -10%;
    height: 100%;
    background:
      radial-gradient(50% 55% at 22% 12%, rgba(79, 197, 213, .20), transparent 70%),
      radial-gradient(45% 45% at 86% 40%, rgba(120, 160, 255, .16), transparent 70%);
    pointer-events: none;
  }
  .h2-hero-grid {
    position: relative; z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    width: 100%;
  }

  .h2-eyebrow {
    display: inline-flex; align-items: center; gap: .55rem;
    font-family: var(--font-m);
    font-size: .7rem; letter-spacing: .16em; text-transform: uppercase;
    color: var(--h2-accent);
    background: rgba(79, 197, 213, .1);
    border: 1px solid rgba(13, 127, 146, .18);
    padding: .4rem .85rem; border-radius: 999px;
    margin: 0 0 1.1rem;
  }
  .h2-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--h2-accent-lt);
    box-shadow: 0 0 0 3px rgba(79, 197, 213, .25);
  }

  .h2-title {
    font-family: var(--font-h);
    font-weight: 900;
    font-size: clamp(2.1rem, 4.2vw, 3.5rem);
    line-height: 1.04;
    letter-spacing: -.025em;
    color: var(--h2-text);
    margin: 0 0 .9rem;
    text-wrap: balance;
  }
  .h2-title em { font-style: normal; color: var(--h2-accent); }

  .h2-lede {
    max-width: 42ch; margin: 0;
    color: var(--h2-body);
    font-size: clamp(.98rem, 1.2vw, 1.1rem);
    line-height: 1.6;
  }
  .h2-cta { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.6rem; }

  /* ---- one-site showcase ---- */
  .h2-showcase { position: relative; }
  .h2-slides {
    position: relative;
    /* reserve the tallest slide's height so nothing jumps when it changes */
    aspect-ratio: 16 / 11;
  }
  .h2-slide {
    position: absolute; inset: 0;
    opacity: 0; transform: scale(.97);
    transition: opacity .55s var(--ease), transform .55s var(--ease);
    pointer-events: none;
  }
  .h2-slide.is-active { opacity: 1; transform: none; pointer-events: auto; }

  .h2-dev { margin: 0; container-type: inline-size; filter: drop-shadow(0 20px 30px rgba(20, 27, 56, .26)); }
  .h2-screen { position: relative; background: #141b2e; }
  .h2-dev :global(img) { display: block; width: 100%; height: auto; }

  .h2-dev--laptop { position: absolute; left: 0; top: 0; width: 88%; }
  .h2-dev--laptop .h2-screen {
    padding: 2.5cqw 2.5cqw 2cqw;
    border-radius: 2.6cqw 2.6cqw 0 0;
    background: linear-gradient(160deg, #1e2740, #10162a);
  }
  .h2-dev--laptop .h2-screen :global(img) { border-radius: .7cqw; }
  .h2-dev--laptop .h2-screen::before {
    content: ''; position: absolute; top: .9cqw; left: 50%; transform: translateX(-50%);
    width: .7cqw; height: .7cqw; border-radius: 50%; background: #38415c;
  }
  .h2-dev--laptop .h2-base {
    width: 108%; margin-left: -4%;
    height: 3cqw;
    background: linear-gradient(180deg, #eef2f7 0%, #cbd3e0 55%, #9fabbf 100%);
    border-radius: 0 0 1.8cqw 1.8cqw;
    position: relative;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .8);
  }
  .h2-dev--laptop .h2-base::after {
    content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%);
    width: 15%; height: 1.1cqw; background: #aeb8c9;
    border-radius: 0 0 1cqw 1cqw;
  }

  .h2-dev--phone { position: absolute; right: 0; bottom: 0; width: 21%; }
  .h2-dev--phone .h2-screen {
    padding: 5cqw;
    border-radius: 15cqw;
    background: linear-gradient(160deg, #232c45, #0e1424);
  }
  .h2-dev--phone .h2-screen :global(img) { border-radius: 11cqw; }
  .h2-dev--phone .h2-screen::after {
    content: ''; position: absolute; top: 5cqw; left: 50%; transform: translateX(-50%);
    width: 36%; height: 4.5cqw; background: #0e1424;
    border-radius: 0 0 3cqw 3cqw; z-index: 2;
  }

  .h2-showcase-meta {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; margin-top: 1.1rem;
  }
  .h2-showcase-name { margin: 0; }
  .h2-showcase-name a { display: flex; flex-direction: column; gap: .1rem; text-decoration: none; }
  .h2-showcase-name strong {
    font-family: var(--font-h); font-weight: 700; font-size: .98rem;
    color: var(--h2-text);
  }
  .h2-showcase-name span {
    font-family: var(--font-m); font-size: .68rem; letter-spacing: .1em;
    text-transform: uppercase; color: var(--h2-muted);
  }
  .h2-showcase-name a:hover strong { color: var(--h2-accent); }

  .h2-dots { display: flex; gap: .45rem; }
  .h2-dot-btn {
    width: 8px; height: 8px; padding: 0; border-radius: 50%;
    border: 0; background: #c3cddb; cursor: pointer;
    transition: background .25s, width .25s;
  }
  .h2-dot-btn.is-active { background: var(--h2-accent); width: 22px; border-radius: 999px; }
  .h2-dot-btn:focus-visible { outline: 2px solid var(--h2-accent); outline-offset: 3px; }

  /* ---- stats ---- */
  .h2-stats {
    display: flex; flex-wrap: wrap;
    gap: .9rem clamp(1.4rem, 3vw, 2.6rem);
    margin: 1.8rem 0 0; padding: 0;
    list-style: none;
  }
  .h2-stats strong {
    display: block;
    font-family: var(--font-h); font-weight: 800;
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    color: var(--h2-accent); line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .h2-stats span {
    display: block; margin-top: .25rem;
    font-size: .76rem; color: var(--h2-muted);
  }

  /* ---- sections lightened ---- */
  .h2-services { background: var(--h2-panel); }
  .h2-work { background: var(--h2-ground); }

  .h2-close {
    background: linear-gradient(180deg, var(--h2-panel), #eef4f8);
    text-align: center;
    padding: clamp(4rem, 9vw, 7rem) 0;
    border-top: 1px solid var(--h2-line);
  }
  .h2-close h2 {
    font-family: var(--font-h); font-weight: 800;
    font-size: clamp(1.9rem, 4.4vw, 3rem);
    color: var(--h2-text); margin: 0 0 .7rem; letter-spacing: -.02em;
  }
  .h2-close p { color: var(--h2-body); margin: 0 0 1.8rem; }
  .h2-close-loc {
    font-family: var(--font-m); font-size: .72rem; letter-spacing: .16em;
    text-transform: uppercase; color: var(--h2-muted); margin: 1.6rem 0 0 !important;
  }

  /* ---- responsive: stack, keeping both devices in the first screen ---- */
  @media (max-width: 1000px) {
    .h2-hero {
      min-height: 100svh;
      padding-top: clamp(4.75rem, 10vh, 6rem);
      padding-bottom: 1.25rem;
    }
    .h2-hero-grid {
      grid-template-columns: 1fr;
      gap: clamp(1.1rem, 3.5vh, 2rem);
      align-content: center;
    }
    .h2-title { font-size: clamp(1.85rem, 7.4vw, 2.6rem); }
    .h2-lede { font-size: .95rem; max-width: 46ch; }
    .h2-cta { margin-top: 1.1rem; }
    .h2-cta .btn { flex: 1 1 auto; justify-content: center; }
    /* stats sit under the devices on small screens, kept compact */
    .h2-stats { order: 2; margin-top: 1.1rem; gap: .6rem 1.4rem; }
    .h2-stats strong { font-size: 1.25rem; }
    .h2-stats span { font-size: .7rem; }
    .h2-showcase-meta { margin-top: .8rem; }
  }

  @media (max-width: 620px) {
    .h2-eyebrow { font-size: .62rem; margin-bottom: .8rem; padding: .32rem .7rem; }
    .h2-title { margin-bottom: .6rem; }
    .h2-lede { font-size: .9rem; }
    .h2-showcase-name strong { font-size: .88rem; }
  }

  /* very short screens: drop the stats and tighten, rather than push the
     devices or the project dots under the fold */
  @media (max-height: 700px) and (max-width: 1000px) {
    .h2-stats { display: none; }
    .h2-hero { padding-top: 4.5rem; padding-bottom: .6rem; }
    .h2-hero-grid { gap: .9rem; }
    .h2-showcase-meta { margin-top: .55rem; }
    .h2-lede { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .h2-slide { transition: none; }
    .h2-dot-btn { transition: none; }
  }
</style>

<style is:global>
  /* The header is transparent-over-dark by default; this page's hero is light,
     so borrow the existing scrolled treatment from the top. Guarded by :has()
     so it can only ever apply on this page. */
  body:has(.h2-hero) .site-head-wrap {
    background: rgba(255, 255, 255, .92);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: 0 1px 0 rgba(20, 27, 56, .08);
  }
  body:has(.h2-hero) .nav-links a { color: var(--lt-text); }
  body:has(.h2-hero) .nav-links a:hover { color: var(--cyan); }
  body:has(.h2-hero) .nav-phone { color: var(--lt-body); }
  body:has(.h2-hero) .nav-burger span { background: var(--lt-text); }
  body:has(.h2-hero) .brand-logo { filter: none; }

  /* Service icon tiles ship dark navy — the only dark blocks on an otherwise
     light page. Swap to a pale cyan tint so the section stays light. */
  body:has(.h2-hero) .service-card-tile {
    background: linear-gradient(160deg, #eaf6f9, #dcedf3);
    color: #0d7f92;
    border: 1px solid rgba(13, 127, 146, .12);
  }
  body:has(.h2-hero) .service-card-tile svg { color: #0d7f92; }
  body:has(.h2-hero) .service-link { color: #0d7f92; }

  /* Work cards ship dark navy; lighten them for this concept. */
  body:has(.h2-hero) .work-card-inner {
    background: #fff;
    border: 1px solid #e2e8f0;
  }
  body:has(.h2-hero) .work-card-content h3 { color: #141b38; }
  body:has(.h2-hero) .work-card-content p { color: #434960; }
  body:has(.h2-hero) .work-client { color: #0d7f92; }
  body:has(.h2-hero) .work-card-cta { color: #0d7f92; }
</style>

<script>
  (() => {
    const slides = [...document.querySelectorAll('.h2-slide')];
    const dots = [...document.querySelectorAll('[data-go]')];
    if (slides.length < 2) return;

    const nameEl = document.querySelector('[data-name]');
    const sectorEl = document.querySelector('[data-sector]');
    const linkEl = document.querySelector('[data-name-link]');
    const meta = slides.map((s) => {
      const i = Number(s.dataset.slide);
      const dot = dots[i];
      return { client: dot?.getAttribute('aria-label') ?? '' };
    });
    // sector + href come from the markup of the first render; read them off the dots' order
    const sectors = JSON.parse(document.getElementById('h2-showcase-data')?.textContent ?? '[]');

    let index = 0;
    let timer = null;
    const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const show = (next) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const on = i === index;
        s.classList.toggle('is-active', on);
        s.setAttribute('aria-hidden', String(!on));
      });
      dots.forEach((d, i) => {
        d.classList.toggle('is-active', i === index);
        d.setAttribute('aria-selected', String(i === index));
      });
      const info = sectors[index];
      if (info) {
        if (nameEl) nameEl.textContent = info.client;
        if (sectorEl) sectorEl.textContent = info.sector;
        if (linkEl) linkEl.setAttribute('href', info.href);
      } else if (nameEl) {
        nameEl.textContent = meta[index].client;
      }
    };

    const start = () => {
      if (REDUCED) return;
      stop();
      timer = window.setInterval(() => show(index + 1), 5000);
    };
    const stop = () => { if (timer) { clearInterval(timer); timer = null; } };

    dots.forEach((d) =>
      d.addEventListener('click', () => { show(Number(d.dataset.go)); start(); })
    );

    // don't animate in a background tab, and pause while someone is looking closely
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    const showcase = document.querySelector('.h2-showcase');
    showcase?.addEventListener('mouseenter', stop);
    showcase?.addEventListener('mouseleave', start);
    showcase?.addEventListener('focusin', stop);

    start();
  })();
</script>
