---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  services.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);
---

<BaseLayout
  title="Services — Web Design, SEO & Branding in Surrey | Cumulus Digital"
  description="Bespoke web design, development, SEO, branding, strategy and hosting for small and local businesses in Surrey. Most clients see a positive impact within weeks."
>
  <PageHero
    eyebrow="What we do"
    lede="Strategy, design, code and marketing that work together — every service below is delivered hands-on by people who've done it for 25+ years."
  >
    Everything you need<br />to grow <em class="glow">online</em>.
  </PageHero>

  <section class="section services-hub">
    <div class="container">
      {rendered.map(({ entry, Content }) => (
        <article class="service-detail" id={entry.id} data-reveal>
          <div class="service-detail-head">
            <div class="service-detail-icon" aria-hidden="true">
              <svg viewBox="0 0 48 48" fill="none">
                <path
                  d={entry.data.iconPath}
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  fill="none"
                />
              </svg>
            </div>
            <h2>{entry.data.title}</h2>
            <div class="service-detail-prose">
              <Content />
            </div>
          </div>
          <ul class="service-outcomes">
            {entry.data.outcomes.map((o) => <li>{o}</li>)}
          </ul>
          {entry.data.href && (
            <a class="service-detail-more" href={entry.data.href}>
              See the full {entry.data.title} service →
            </a>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- sector pages -->
  <section class="section" style="background:var(--grey-50)">
    <div class="container">
      <div class="section-header">
        <p class="section-label">By sector</p>
        <h2 class="section-title">We know some industries<br />better than others.</h2>
        <p class="section-sub">Two we know inside out — where we can skip the learning curve entirely.</p>
      </div>
      <ul class="services-grid" role="list">
        <li class="service-card">
          <div class="service-card-body">
            <h3>Travel industry</h3>
            <p>Tour operators, agents, resorts and destination brands — backed by 25+ years inside the sector.</p>
            <a class="service-link" href="/services/travel-industry/">Travel marketing →</a>
          </div>
        </li>
        <li class="service-card">
          <div class="service-card-body">
            <h3>Trades &amp; construction</h3>
            <p>Groundworks, surfacing, fencing, landscaping and construction firms across Surrey and the South East.</p>
            <a class="service-link" href="/services/trades/">Trades marketing →</a>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- travel cross-link -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-inner">
        <div class="cta-glow" aria-hidden="true"></div>
        <p class="section-label">Travel industry?</p>
        <h2 class="cta-headline">
          25+ years inside<br />your <em class="glow">sector</em>.
        </h2>
        <p class="cta-sub">
          Operators, agents, DMOs and travel tech — we know the industry from the inside.
        </p>
        <div class="cta-actions">
          <a class="btn btn--primary btn--lg" href="/services/travel-industry/">Travel industry →</a>
          <a class="btn btn--ghost btn--lg" href="/contact/">Start a project</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
