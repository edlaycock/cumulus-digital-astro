---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { ContactWithGlobe } from '../components/ui/contact-with-globe';
import { EMAIL, FORM_ENDPOINT, PHONE_DISPLAY, PHONE_TEL, TURNSTILE_SITE_KEY } from '../consts';

const services = [
  ...(await getCollection('services')).sort((a, b) => a.data.order - b.data.order).map((s) => s.data.title),
  'Travel industry project',
];
---

<BaseLayout
  title="Contact — Start a Project | Cumulus Digital"
  description="Get in touch with Cumulus Digital, your Surrey web design and digital marketing agency. Call 020 8050 4754 or send us a message — we reply within one working day."
>
  <PageHero
    glass
    eyebrow="Contact"
    lede="Tell us about your project — we'll come back within one working day."
  >
    Let's make your<br />idea <em class="glow">happen</em>.
  </PageHero>

  <section class="section cwg-section">
    <div class="container">
      <ContactWithGlobe
        client:visible
        email={EMAIL}
        phoneDisplay={PHONE_DISPLAY}
        phoneTel={PHONE_TEL}
        endpoint={FORM_ENDPOINT}
        turnstileSiteKey={TURNSTILE_SITE_KEY}
        services={services}
      />
    </div>
    <noscript><style>.cwg [data-fade] { opacity: 1 !important; transform: none !important; }</style></noscript>
  </section>
</BaseLayout>
