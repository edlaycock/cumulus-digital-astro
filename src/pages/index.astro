---
// Homepage: light palette, floating collage of real client sites (one per screen).
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCards from '../components/ServiceCards';
import WorkPreview from '../components/WorkPreview.astro';
import ReviewCarousel from '../components/ReviewCarousel.astro';
import ClientBand from '../components/ClientBand.astro';

import scDesktop from '../assets/work/surrey-contracting-desktop.jpg';
import jlDesktop from '../assets/work/jellylearn-desktop.jpg';
import castDesktop from '../assets/work/castellum-desktop.jpg';
import chhDesktop from '../assets/work/cotswold-house-hunter-desktop.jpg';
import shsDesktop from '../assets/work/surrey-hills-surfacing-desktop.jpg';
import fidMobile from '../assets/work/fidelity-accountants-mobile.jpg';
import rakMobile from '../assets/work/ras-al-khaimah-holidays-mobile.jpg';

const services = (await getCollection('services'))
  .filter((s) => s.data.showOnHome)
  .sort((a, b) => a.data.order - b.data.order);

const serviceItems = services.map((s) => ({
  title: s.data.title,
  summary: s.data.summary,
  iconPath: s.data.iconPath,
  href: `/services/#${s.id}`,
  linkText: 'Learn more →',
}));

const reviews = (await getCollection('testimonials')).map((t) => t.data);

const work = (await getCollection('work'))
  .filter((w) => !w.data.draft)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

// Collage: seven screens, seven different client sites — no project appears twice.
const collage = [
  { img: scDesktop,   client: 'Surrey Contracting',     slot: 'centre', delay: '0s'    },
  { img: jlDesktop,   client: 'JellyLearn',             slot: 'tl',     delay: '-1.2s' },
  { img: castDesktop, client: 'Castellum',              slot: 'tr',     delay: '-2.5s' },
  { img: chhDesktop,  client: 'Cotswold House Hunter',  slot: 'br',     delay: '-3.5s' },
  { img: shsDesktop,  client: 'Surrey Hills Surfacing', slot: 'bl',     delay: '-4.4s' },
  { img: fidMobile,   client: 'Fidelity Accountants',   slot: 'far-l',  delay: '-5.2s', phone: true, label: 'Fidelity' },
  { img: rakMobile,   client: 'Ras Al Khaimah Holidays',slot: 'far-r',  delay: '-6s',   phone: true, label: 'Ras Al Khaimah' },
];
---

<BaseLayout
  title="Web Design in Surrey — Cumulus Digital"
  description="Web design in Surrey that makes ideas happen. Bespoke branding, hand-built websites, SEO and Google Ads for ambitious UK businesses. Based in Hersham, Walton-on-Thames."
>
  <div class="h2">
    <!-- ===================== HERO ===================== -->
    <section class="h2-hero">
      <div class="h2-wash" aria-hidden="true"></div>

      <div class="container h2-hero-copy">
        <p class="h2-eyebrow"><span class="h2-dot"></span> Digital marketing &amp; web · Surrey, UK</p>
        <h1 class="h2-title">Web design in Surrey<br />that makes ideas <em>happen</em>.</h1>
        <p class="h2-lede">
          Bespoke branding, fast hand-built websites and search marketing for ambitious
          UK businesses — backed by 25&nbsp;years in the travel sector.
        </p>
        <div class="h2-cta">
          <a class="btn btn--primary btn--lg" href="/contact/" data-magnetic>Start a project →</a>
          <a class="btn btn--outline btn--lg" href="/work/">See our work</a>
        </div>
      </div>

      <!-- Floating collage of real client sites -->
      <div class="h2-stage" aria-label="Recent websites built by Cumulus Digital">
        <div class="h2-stage-inner">
          {collage.map((c) => (
            <figure
              class={`h2-shot h2-shot--${c.slot} ${c.phone ? 'h2-shot--phone' : 'h2-shot--laptop'}`}
              style={`--d:${c.delay}`}
            >
              <div class="h2-screen">
                <Image
                  src={c.img}
                  alt={`${c.client} website built by Cumulus Digital`}
                  widths={c.phone ? [180, 360] : [420, 840]}
                  sizes={c.phone ? '150px' : '380px'}
                  loading={c.slot === 'centre' ? 'eager' : 'lazy'}
                />
              </div>
              {!c.phone && <div class="h2-base" aria-hidden="true"></div>}
              <figcaption>{c.label ?? c.client}</figcaption>
            </figure>
          ))}
        </div>
      </div>

      <div class="container">
        <ul class="h2-stats" role="list">
          <li><strong>28</strong><span>Projects in our portfolio</span></li>
          <li><strong>25+</strong><span>Years travel experience</span></li>
          <li><strong>2015</strong><span>Serving Surrey since</span></li>
        </ul>
      </div>
    </section>

    <ClientBand />

    <!-- ===================== SERVICES ===================== -->
    <section class="section h2-services">
      <div class="container">
        <div class="section-header">
          <p class="section-label">What we do</p>
          <h2 class="section-title">Everything you need<br />to grow online.</h2>
          <p class="section-sub">
            From first impression to lasting impact — strategy, design, code and
            marketing that work together.
          </p>
        </div>
        <ServiceCards items={serviceItems} client:visible />
      </div>
    </section>

    <!-- ===================== WORK ===================== -->
    <section class="section h2-work">
      <div class="container">
        <div class="section-header">
          <p class="section-label">Our work</p>
          <h2 class="section-title">Ideas made real.</h2>
          <p class="section-sub">A few of the 28 projects in our portfolio.</p>
        </div>

        <ul class="work-grid" role="list">
          {work.map((item) => (
            <li class="work-card">
              <a class="work-card-inner" href={`/work/${item.id}/`}>
                <WorkPreview client={item.data.client} url={item.data.url} image={item.data.mockup ?? item.data.image} />
                <div class="work-card-content">
                  <span class="work-tag">{item.data.services.join(' + ')}</span>
                  <span class="work-client">{item.data.client}</span>
                  <h3>{item.data.title}</h3>
                  <p>{item.data.summary}</p>
                  <span class="work-card-cta">View case study →</span>
                </div>
              </a>
            </li>
          ))}
        </ul>

        <div class="work-cta">
          <a class="btn btn--outline btn--lg" href="/work/">See all 28 case studies →</a>
        </div>
      </div>
    </section>

    <!-- ===================== REVIEWS ===================== -->
    <section class="section h2-reviews">
      <div class="container">
        <div class="section-header">
          <p class="section-label">Reviews</p>
          <h2 class="section-title">What our clients say.</h2>
          <p class="section-sub">Real words from the businesses we've built for.</p>
        </div>
        <ReviewCarousel reviews={reviews} />
      </div>
    </section>

    <!-- ===================== CTA ===================== -->
    <section class="h2-close">
      <div class="container">
        <h2>Let's make your idea happen.</h2>
        <p>Tell us what you're building. We'll tell you honestly how we'd approach it.</p>
        <a class="btn btn--primary btn--lg" href="/contact/" data-magnetic>Start a project →</a>
        <p class="h2-close-loc">Hersham · Walton-on-Thames · Surrey</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* ---------------------------------------------------------------
     Light concept. Scoped to this page — the live homepage is untouched.
     Cyan is too light for text on white, so a deepened cyan carries type
     and the bright accent stays for fills and rules.
  ---------------------------------------------------------------- */
  .h2 {
    --h2-ground: #f6f9fb;
    --h2-panel: #ffffff;
    --h2-accent: #0d7f92;
    --h2-accent-lt: #4fc5d5;
    --h2-text: #141b38;
    --h2-body: #434960;
    --h2-muted: #6b7594;
    --h2-line: #e2e8f0;
    background: var(--h2-ground);
  }

  /* ---- hero ---- */
  .h2-hero {
    position: relative;
    display: flex; flex-direction: column; justify-content: center;
    min-height: 100svh;
    padding: clamp(5.25rem, 10vh, 7rem) 0 clamp(1rem, 2.5vh, 2rem);
    overflow: hidden;
    background: var(--h2-ground);
  }
  .h2-wash {
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 90%;
    background:
      radial-gradient(60% 55% at 50% 8%, rgba(79, 197, 213, .20), transparent 70%),
      radial-gradient(40% 40% at 88% 30%, rgba(120, 160, 255, .14), transparent 70%);
    pointer-events: none;
  }
  .h2-hero-copy { position: relative; z-index: 2; text-align: center; }

  .h2-eyebrow {
    display: inline-flex; align-items: center; gap: .55rem;
    font-family: var(--font-m);
    font-size: .72rem; letter-spacing: .18em; text-transform: uppercase;
    color: var(--h2-accent);
    background: rgba(79, 197, 213, .1);
    border: 1px solid rgba(13, 127, 146, .18);
    padding: .4rem .85rem; border-radius: 999px;
    margin: 0 0 1rem;
  }
  .h2-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--h2-accent-lt);
    box-shadow: 0 0 0 3px rgba(79, 197, 213, .25);
  }

  .h2-title {
    font-family: var(--font-h);
    font-weight: 900;
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    line-height: 1.03;
    letter-spacing: -.025em;
    color: var(--h2-text);
    margin: 0 0 .8rem;
    text-wrap: balance;
  }
  .h2-title em { font-style: normal; color: var(--h2-accent); }

  .h2-lede {
    max-width: 46ch; margin: 0 auto;
    color: var(--h2-body);
    font-size: clamp(.95rem, 1.2vw, 1.06rem);
    line-height: 1.55;
  }
  .h2-cta {
    display: flex; flex-wrap: wrap; gap: .8rem;
    justify-content: center; margin-top: 1.3rem;
  }

  /* ---- collage ---- */
  .h2-stage {
    position: relative; z-index: 1;
    margin-top: clamp(1.2rem, 2.5vh, 2rem);
    height: clamp(240px, 40vh, 470px);
  }
  .h2-stage-inner {
    position: relative;
    height: 100%;
    max-width: 1240px;
    margin: 0 auto;
  }

  /* Each shot is a device. Bezels are sized in cqw so the frame scales with
     the card rather than needing a magic number per position. */
  .h2-shot {
    position: absolute;
    margin: 0;
    container-type: inline-size;
    filter: drop-shadow(0 22px 34px rgba(20, 27, 56, .28));
    animation: h2-float 7s ease-in-out infinite;
    animation-delay: var(--d);
  }
  .h2-screen { position: relative; background: #141b2e; }
  .h2-shot :global(img) { display: block; width: 100%; height: auto; }

  /* ---- laptop ---- */
  .h2-shot--laptop .h2-screen {
    padding: 2.4cqw 2.4cqw 2cqw;
    border-radius: 2.4cqw 2.4cqw 0 0;
    background: linear-gradient(160deg, #1e2740, #10162a);
  }
  .h2-shot--laptop .h2-screen :global(img) { border-radius: .7cqw; }
  /* camera */
  .h2-shot--laptop .h2-screen::before {
    content: ''; position: absolute; top: 1cqw; left: 50%; transform: translateX(-50%);
    width: .7cqw; height: .7cqw; border-radius: 50%; background: #38415c;
  }
  .h2-base {
    /* base sits slightly wider than the lid, as on a real laptop */
    width: 108%; margin-left: -4%;
    height: 3cqw;
    background: linear-gradient(180deg, #eef2f7 0%, #cbd3e0 55%, #9fabbf 100%);
    border-radius: 0 0 1.8cqw 1.8cqw;
    position: relative;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .8);
  }
  /* the little lip on the front edge */
  .h2-base::after {
    content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%);
    width: 15%; height: 1.1cqw; background: #aeb8c9;
    border-radius: 0 0 1cqw 1cqw;
  }

  /* ---- phone ---- */
  .h2-shot--phone .h2-screen {
    padding: 3.4cqw;
    border-radius: 11cqw;
    background: linear-gradient(160deg, #232c45, #0e1424);
  }
  .h2-shot--phone .h2-screen :global(img) { border-radius: 8cqw; }
  /* notch */
  .h2-shot--phone .h2-screen::after {
    content: ''; position: absolute; top: 3.4cqw; left: 50%; transform: translateX(-50%);
    width: 34%; height: 3.4cqw; background: #0e1424;
    border-radius: 0 0 2.4cqw 2.4cqw; z-index: 2;
  }

  /* right-hand cards label on their outer edge, so the centre laptop
     can never sit over the name */
  .h2-shot--tr figcaption,
  .h2-shot--br figcaption { left: auto !important; right: 3.4cqw; }

  .h2-shot figcaption {
    position: absolute; left: 3.4cqw; bottom: 4.4cqw;
    font-family: var(--font-m); font-size: .58rem; letter-spacing: .06em;
    color: #fff; background: rgba(10, 14, 30, .74);
    padding: .26rem .48rem; border-radius: 5px;
    backdrop-filter: blur(6px);
  }

  /* the phone frames are far narrower, so their label centres and shrinks */
  .h2-shot--phone figcaption {
    left: 50%; right: auto; transform: translateX(-50%);
    bottom: 8cqw; font-size: .48rem; white-space: nowrap;
  }

  /* landscape browser shots */
  .h2-shot--centre { width: 33%;   left: 50%;   top: 50%; transform: translate(-50%, -50%); z-index: 5; }
  .h2-shot--tl     { width: 26%;   left: 13%;   top: 1%;    z-index: 3; }
  .h2-shot--tr     { width: 24%;   right: 13%;  top: 0;     z-index: 3; }
  .h2-shot--br     { width: 27%;   right: 11%;  bottom: 2%; z-index: 4; }
  .h2-shot--bl     { width: 26%;   left: 11%;   bottom: 0;  z-index: 4; }
  /* Portrait shots are ~2.2x taller than they are wide, so on short screens a
     width-only size overflows the stage. Cap against viewport height and centre. */
  .h2-shot--far-l,
  .h2-shot--far-r  { width: min(11%, 13vh); top: 50%; transform: translateY(-50%); z-index: 6; }
  .h2-shot--far-l  { left: 1%; }
  .h2-shot--far-r  { right: 1%; }

  @keyframes h2-float {
    0%, 100% { translate: 0 0;      filter: drop-shadow(0 18px 26px rgba(20, 27, 56, .26)); }
    50%      { translate: 0 -16px;  filter: drop-shadow(0 30px 40px rgba(20, 27, 56, .32)); }
  }
  /* shorter travel where the screens are smaller */
  @keyframes h2-float-sm {
    0%, 100% { translate: 0 0;      filter: drop-shadow(0 8px 14px rgba(20, 27, 56, .22)); }
    50%      { translate: 0 -9px;   filter: drop-shadow(0 16px 22px rgba(20, 27, 56, .28)); }
  }

  /* ---- stats ---- */
  .h2-stats {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: .8rem clamp(1.6rem, 4vw, 3.2rem);
    margin: clamp(1rem, 2.2vh, 1.6rem) 0 0; padding: 0;
    list-style: none; position: relative; z-index: 2;
  }
  .h2-stats li { text-align: center; }
  .h2-stats strong {
    display: block;
    font-family: var(--font-h); font-weight: 800;
    font-size: clamp(1.35rem, 2.2vw, 1.85rem);
    color: var(--h2-accent); line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .h2-stats span {
    display: block; margin-top: .25rem;
    font-size: .74rem; color: var(--h2-muted);
  }

  /* ---- sections lightened ---- */
  .h2-services { background: var(--h2-panel); }
  .h2-work { background: var(--h2-ground); }

  .h2-close {
    background: linear-gradient(180deg, var(--h2-panel), #eef4f8);
    text-align: center;
    padding: clamp(4rem, 9vw, 7rem) 0;
    border-top: 1px solid var(--h2-line);
  }
  .h2-close h2 {
    font-family: var(--font-h); font-weight: 800;
    font-size: clamp(1.9rem, 4.4vw, 3rem);
    color: var(--h2-text); margin: 0 0 .7rem; letter-spacing: -.02em;
  }
  .h2-close p { color: var(--h2-body); margin: 0 0 1.8rem; }
  .h2-close-loc {
    font-family: var(--font-m); font-size: .72rem; letter-spacing: .16em;
    text-transform: uppercase; color: var(--h2-muted); margin: 1.6rem 0 0 !important;
  }

  /* ---- responsive ---- */
  /* Below 900px the floating layout gets cramped, so the devices become a
     grid — still every site on its own screen, still inside the first view. */
  @media (max-width: 900px) {
    .h2-hero { padding-top: clamp(4.75rem, 9vh, 5.75rem); }
    .h2-title { font-size: clamp(1.75rem, 6.6vw, 2.4rem); }
    .h2-lede { font-size: .92rem; max-width: 40ch; }
    .h2-cta { margin-top: 1rem; }
    .h2-cta .btn { flex: 1 1 auto; justify-content: center; }

    .h2-stage { height: auto; margin-top: 1.1rem; }
    .h2-stage-inner {
      display: grid;
      /* 5 tracks: laptops span 2, phones span 1 — so the portrait shots
         stay narrow and the rows stay short */
      grid-template-columns: repeat(5, 1fr);
      align-items: end;
      gap: 8px;
      max-width: 100%;
    }
    .h2-shot {
      position: static; width: auto !important;
      transform: none !important;
      animation: h2-float-sm 7s ease-in-out infinite;
      animation-delay: var(--d);
    }
    /* each row: a phone alongside two laptops */
    .h2-shot--far-l  { grid-column: 1 / 2; grid-row: 1; }
    .h2-shot--centre { grid-column: 2 / 4; grid-row: 1; }
    .h2-shot--tl     { grid-column: 4 / 6; grid-row: 1; }
    .h2-shot--bl     { grid-column: 1 / 3; grid-row: 2; }
    .h2-shot--br     { grid-column: 3 / 5; grid-row: 2; }
    .h2-shot--far-r  { grid-column: 5 / 6; grid-row: 2; }
    .h2-shot--tr     { display: none; }
    .h2-shot figcaption { font-size: .5rem; left: 4cqw; bottom: 5cqw; }
    .h2-stats { justify-content: center; }
  }

  @media (max-width: 620px) {
    .h2-eyebrow { font-size: .62rem; margin-bottom: .8rem; }
    .h2-shot figcaption { display: none; }
  }

  /* short screens: shed the supporting copy before the work loses space */
  @media (max-height: 720px) and (max-width: 900px) {
    .h2-lede { display: none; }
    .h2-stats { display: none; }
  }
  @media (max-height: 820px) and (min-width: 901px) {
    .h2-stats { display: none; }
    .h2-stage { height: clamp(210px, 33vh, 330px); }
    .h2-title { font-size: clamp(1.9rem, 3.4vw, 2.7rem); }
    .h2-lede { font-size: .95rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .h2-shot { animation: none; }
  }
</style>

<style is:global>
  /* The header is transparent-over-dark by default; this page's hero is light,
     so borrow the existing scrolled treatment from the top. Guarded by :has()
     so it can only ever apply on this page. */
  body:has(.h2-hero) .site-head-wrap {
    background: rgba(255, 255, 255, .92);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: 0 1px 0 rgba(20, 27, 56, .08);
  }
  body:has(.h2-hero) .nav-links a { color: var(--lt-text); }
  body:has(.h2-hero) .nav-links a:hover { color: var(--cyan); }
  body:has(.h2-hero) .nav-phone { color: var(--lt-body); }
  body:has(.h2-hero) .nav-burger span { background: var(--lt-text); }
  body:has(.h2-hero) .brand-logo { filter: none; }

  /* Service icon tiles ship dark navy — the only dark blocks on an otherwise
     light page. Swap to a pale cyan tint so the section stays light. */
  body:has(.h2-hero) .service-card-tile {
    background: linear-gradient(160deg, #eaf6f9, #dcedf3);
    color: #0d7f92;
    border: 1px solid rgba(13, 127, 146, .12);
  }
  body:has(.h2-hero) .service-card-tile svg { color: #0d7f92; }
  body:has(.h2-hero) .service-link { color: #0d7f92; }

  /* Work cards ship dark navy; lighten them for this concept. */
  body:has(.h2-hero) .work-card-inner {
    background: #fff;
    border: 1px solid #e2e8f0;
  }
  body:has(.h2-hero) .work-card-content h3 { color: #141b38; }
  body:has(.h2-hero) .work-card-content p { color: #434960; }
  body:has(.h2-hero) .work-client { color: #0d7f92; }
  body:has(.h2-hero) .work-card-cta { color: #0d7f92; }
</style>
