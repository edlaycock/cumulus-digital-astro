---
// Homepage: white canvas, monumental type, and a scrolling wall of the real
// client sites we've built — the product is the visual content.
import { getCollection } from 'astro:content';
import { clientMarquee } from '../lib/client-marquee';
import ImpactHero from '../components/ImpactHero.astro';
import { ScreenshotMarquee } from '../components/ui/screenshot-marquee';
import heroDesktop from '../assets/work/surrey-contracting-scroll-desktop.jpg';
import heroMobile from '../assets/work/surrey-contracting-scroll-mobile.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCards from '../components/ServiceCards';
import WorkPreview from '../components/WorkPreview.astro';
import ReviewCarousel from '../components/ReviewCarousel.astro';
import ClientBand from '../components/ClientBand.astro';
import PhoneShowcase from '../components/PhoneShowcase.astro';


const services = (await getCollection('services'))
  .filter((s) => s.data.showOnHome)
  .sort((a, b) => a.data.order - b.data.order);

const serviceItems = services.map((s) => ({
  title: s.data.title,
  summary: s.data.summary,
  iconPath: s.data.iconPath,
  href: s.data.href ?? `/services/#${s.id}`,
  linkText: s.data.href ? 'See the full service →' : 'Learn more →',
}));

const reviews = (await getCollection('testimonials')).map((t) => t.data);

const work = (await getCollection('work'))
  .filter((w) => !w.data.draft)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

// The strip of client sites. The hero client is skipped — it is already the
// site in the device above, and seeing it twice within one screen reads as a
// mistake.
const marquee = await clientMarquee(['surrey-contracting']);

---

<BaseLayout
  title="Web Design in Surrey &amp; Beyond — Cumulus Digital"
  description="Web design in Surrey and beyond. Bespoke branding, hand-built websites, SEO and Google Ads for ambitious UK businesses. Based in Hersham, Walton-on-Thames."
>
  <div class="h2">
    <!-- ===================== HERO ===================== -->
    <ImpactHero
      badge="Digital marketing &amp; web · Surrey, UK"
      title="Web design in Surrey"
      titleAccent="&amp; beyond."
      titleAccentAlt="&amp; London."
      lede="Bespoke branding, fast hand-built websites and search marketing for ambitious UK businesses — backed by 25 years in the travel sector."
      ticks={["100's of projects delivered", 'Serving Surrey since 2015', 'No long-term contracts']}
      ctaText="Start a project →"
      ctaHref="/contact/"
      secondaryText="See our work"
      secondaryHref="/work/"
      desktop={heroDesktop}
      mobile={heroMobile}
      scroll
      alt="The Surrey Contracting website, designed and built by Cumulus Digital"
      chips={[
        { text: 'Live in two weeks', at: 'tr' },
        { text: 'Built for Surrey Contracting', at: 'bl' },
      ]}
    />

    <!-- the rest of the portfolio, scrolling -->
    <ScreenshotMarquee images={marquee} client:visible />

    <div class="container">
      <ul class="h2-stats" role="list">
        <li><strong>100's</strong><span>Projects delivered</span></li>
        <li><strong>25+</strong><span>Years travel experience</span></li>
        <li><strong>2015</strong><span>Serving Surrey since</span></li>
      </ul>
    </div>

    <ClientBand />

    <!-- ===================== SERVICES ===================== -->
    <section class="section h2-services">
      <div class="container">
        <div class="section-header">
          <p class="section-label">What we do</p>
          <h2 class="section-title">Everything you need<br />to grow <em>online</em>.</h2>
          <p class="section-sub">
            From first impression to lasting impact — strategy, design, code and
            marketing that work together.
          </p>
        </div>
        <ServiceCards items={serviceItems} client:visible />
      </div>
    </section>

    <!-- ===================== MOBILE-FIRST BREAK ===================== -->
    <PhoneShowcase />

    <!-- ===================== WORK ===================== -->
    <section class="section h2-work">
      <div class="container">
        <div class="section-header">
          <p class="section-label">Our work</p>
          <h2 class="section-title">Ideas made <em>real</em>.</h2>
          <p class="section-sub">A few of the projects we are proudest of.</p>
        </div>

        <ul class="work-grid" role="list">
          {work.map((item) => (
            <li class="work-card">
              <a class="work-card-inner" href={`/work/${item.id}/`}>
                <WorkPreview client={item.data.client} url={item.data.url} image={item.data.mockup ?? item.data.image} />
                <div class="work-card-content">
                  <span class="work-tag">{item.data.services.join(' + ')}</span>
                  <span class="work-client">{item.data.client}</span>
                  <h3>{item.data.title}</h3>
                  <p>{item.data.summary}</p>
                  <span class="work-card-cta">View case study →</span>
                </div>
              </a>
            </li>
          ))}
        </ul>

        <div class="work-cta">
          <a class="btn btn--outline btn--lg" href="/work/">See all case studies →</a>
        </div>
      </div>
    </section>

    <!-- ===================== REVIEWS ===================== -->
    <section class="section h2-reviews">
      <div class="container">
        <div class="section-header">
          <p class="section-label">Reviews</p>
          <h2 class="section-title">What our clients <em>say</em>.</h2>
          <p class="section-sub">Real words from the businesses we've built for.</p>
        </div>
        <ReviewCarousel reviews={reviews} />
      </div>
    </section>

    <!-- ===================== CTA ===================== -->
    <section class="h2-close">
      <div class="container">
        <h2>Let's make your idea <em>happen</em>.</h2>
        <p>Tell us what you're building. We'll tell you honestly how we'd approach it.</p>
        <a class="btn btn--primary btn--lg" href="/contact/" data-magnetic>Start a project →</a>
        <p class="h2-close-loc">Hersham · Walton-on-Thames · Surrey</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Page-scoped bits the shared system doesn't cover: the stat row under
     the hero and the closing block. Everything else now comes from
     global.css — this page no longer overrides the palette. */
  .h2-stats {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    max-width: 46rem;
    margin: 0 auto;
    padding: 2.5rem 0 1rem;
  }
  .h2-stats li { text-align: center; }
  .h2-stats strong {
    display: block;
    font-family: var(--font-h);
    font-weight: 700;
    font-size: clamp(1.9rem, 4vw, 2.9rem);
    letter-spacing: -.05em;
    color: var(--ink-black);
    line-height: 1;
  }
  .h2-stats span {
    display: block;
    margin-top: .4rem;
    font-size: .82rem;
    color: var(--lt-muted);
  }

  .h2-close {
    text-align: center;
    padding: var(--section-pad) 0;
    border-top: 1px solid var(--lt-border);
  }
  .h2-close h2 {
    font-family: var(--font-h);
    font-weight: 700;
    font-size: clamp(2.4rem, 7vw, 5rem);
    line-height: .98;
    letter-spacing: -.055em;
    color: var(--ink-black);
    margin: 0 0 1rem;
    text-wrap: balance;
  }
  .h2-close p { color: var(--lt-muted); margin: 0 0 1.8rem; }
  .h2-close-loc {
    margin-top: 1.6rem !important;
    font-family: var(--font-m);
    font-size: .82rem;
    color: var(--lt-muted);
  }

  @media (max-width: 620px) {
    .h2-stats { padding-top: 1.5rem; gap: .5rem; }
  }
</style>

